<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mini E-Commerce Cart System</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

body{
    background:#f4f4f4;
    padding:20px;
}

.container{
    max-width:1200px;
    margin:auto;
}

h1{
    text-align:center;
    color:#2c3e50;
    margin-bottom:20px;
}

.products{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:20px;
}

.product-card{
    background:white;
    border-radius:10px;
    padding:15px;
    text-align:center;
    box-shadow:0 2px 8px rgba(0,0,0,0.2);
}

.product-card img{
    width:100%;
    height:180px;
    object-fit:cover;
    border-radius:10px;
}

.product-card h3{
    margin:10px 0;
}

.price{
    color:green;
    font-weight:bold;
    margin-bottom:10px;
}

button{
    padding:8px 12px;
    border:none;
    border-radius:5px;
    cursor:pointer;
    color:white;
}

.add-btn{
    background:#3498db;
}

.add-btn:hover{
    background:#2980b9;
}

.cart{
    margin-top:30px;
    background:white;
    padding:20px;
    border-radius:10px;
    box-shadow:0 2px 8px rgba(0,0,0,0.2);
}

.cart h2{
    margin-bottom:15px;
}

.cart-item{
    display:flex;
    justify-content:space-between;
    align-items:center;
    border-bottom:1px solid #ddd;
    padding:10px 0;
}

.qty-btn{
    background:green;
    margin:0 5px;
}

.remove-btn{
    background:red;
}

.total{
    margin-top:15px;
    font-size:22px;
    font-weight:bold;
    color:#2c3e50;
}

.empty{
    color:gray;
}
</style>
</head>

<body>

<div class="container">

<h1>Mini E-Commerce Cart System</h1>

<div class="products" id="productList"></div>

<div class="cart">

<h2>Shopping Cart</h2>

<div id="cartItems">
<p class="empty">Cart is Empty</p>
</div>

<div class="total" id="totalPrice">
Total: ₹0
</div>

</div>

</div>

<script>

const products = [
{
id:1,
name:"Laptop",
price:45000,
image:"https://via.placeholder.com/250x180?text=Laptop"
},
{
id:2,
name:"Smartphone",
price:20000,
image:"https://via.placeholder.com/250x180?text=Phone"
},
{
id:3,
name:"Headphones",
price:2500,
image:"https://via.placeholder.com/250x180?text=Headphones"
},
{
id:4,
name:"Smart Watch",
price:5000,
image:"https://via.placeholder.com/250x180?text=Watch"
},
{
id:5,
name:"Keyboard",
price:1500,
image:"https://via.placeholder.com/250x180?text=Keyboard"
},
{
id:6,
name:"Mouse",
price:800,
image:"https://via.placeholder.com/250x180?text=Mouse"
}
];

let cart = [];

function displayProducts(){

const productList =
document.getElementById("productList");

productList.innerHTML = "";

products.forEach(product => {

productList.innerHTML += `
<div class="product-card">

<img src="${product.image}" alt="${product.name}">

<h3>${product.name}</h3>

<p class="price">₹${product.price}</p>

<button class="add-btn"
onclick="addToCart(${product.id})">
Add to Cart
</button>

</div>
`;

});

}

function addToCart(id){

const product =
products.find(p => p.id === id);

const existing =
cart.find(item => item.id === id);

if(existing){
existing.quantity++;
}
else{
cart.push({
...product,
quantity:1
});
}

displayCart();

}

function displayCart(){

const cartItems =
document.getElementById("cartItems");

cartItems.innerHTML = "";

let total = 0;

if(cart.length === 0){

cartItems.innerHTML =
"<p class='empty'>Cart is Empty</p>";

document.getElementById("totalPrice")
.innerHTML = "Total: ₹0";

return;
}

cart.forEach(item => {

total += item.price * item.quantity;

cartItems.innerHTML += `
<div class="cart-item">

<div>
<b>${item.name}</b><br>
₹${item.price}
</div>

<div>

<button class="qty-btn"
onclick="changeQuantity(${item.id},-1)">
-
</button>

${item.quantity}

<button class="qty-btn"
onclick="changeQuantity(${item.id},1)">
+
</button>

<button class="remove-btn"
onclick="removeItem(${item.id})">
Remove
</button>

</div>

</div>
`;

});

document.getElementById("totalPrice")
.innerHTML = "Total: ₹" + total;

}

function changeQuantity(id,value){

const item =
cart.find(item => item.id === id);

item.quantity += value;

if(item.quantity <= 0){

cart = cart.filter(
product => product.id !== id
);

}

displayCart();

}

function removeItem(id){

cart = cart.filter(
product => product.id !== id
);

displayCart();

}

displayProducts();

</script>

</body>
</html>